// ----------
// Core type
// ----------

h1, h2, h3, h4, h5, p {
  mgn(1, 0)
  max-width $pwidth*1em
}

h1, h2 {
  -webkit-font-smoothing: antialiased
  -moz-osx-font-smoothing: grayscale
}

h1 {
  font-weight: 800
  fs(mp(5))
}

h2 {
  font-weight: 600
  fs(mp(4))
}

h3 {
  fs(mp(3))
}

h4 {
  fs(mp(2))
}

// ----------
// Modifers
// ----------

strong, b
  font-weight 400
  letter-spacing normal

em, i
  font-style italic

sup
  font-size smaller
  vertical-align top
