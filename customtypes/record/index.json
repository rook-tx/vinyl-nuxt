{
  "format": "page",
  "id": "record",
  "label": "Record",
  "repeatable": true,
  "status": true,
  "json": {
    "Main": {
      "uid": {
        "type": "UID",
        "config": {
          "label": "UID"
        }
      },
      "title": {
        "type": "Text",
        "config": {
          "label": "Title",
          "placeholder": ""
        }
      },
      "cover": {
        "type": "Image",
        "config": {
          "label": "Cover",
          "constraint": {},
          "thumbnails": []
        }
      },
      "artist": {
        "type": "Link",
        "config": {
          "label": "Artist",
          "select": "document",
          "repeat": false,
          "customtypes": [
            {
              "id": "artist",
              "fields": ["name"]
            }
          ]
        }
      },
      "record_id": {
        "type": "Text",
        "config": {
          "label": "Record ID",
          "placeholder": ""
        }
      },
      "played": {
        "type": "Group",
        "config": {
          "label": "Played",
          "repeat": true,
          "fields": {
            "date": {
              "type": "Date",
              "config": {
                "label": "Date",
                "placeholder": ""
              }
            }
          }
        }
      },
      "discs": {
        "type": "Number",
        "config": {
          "label": "Discs",
          "placeholder": ""
        }
      },
      "label": {
        "type": "Text",
        "config": {
          "label": "Label",
          "placeholder": ""
        }
      },
      "year": {
        "type": "Number",
        "config": {
          "label": "Year",
          "placeholder": ""
        }
      },
      "original_year": {
        "type": "Number",
        "config": {
          "label": "Original Year",
          "placeholder": ""
        }
      },
      "notes": {
        "type": "StructuredText",
        "config": {
          "label": "Notes",
          "placeholder": "",
          "allowTargetBlank": true,
          "multi": "paragraph,o-list-item,list-item,hyperlink"
        }
      },
      "slices": {
        "type": "Slices",
        "fieldset": "Slice Zone",
        "config": {
          "choices": {}
        }
      }
    },
    "SEO & Metadata": {
      "meta_title": {
        "config": {
          "label": "Meta Title",
          "placeholder": "A title of the page used for social media and search engines"
        },
        "type": "Text"
      },
      "meta_description": {
        "config": {
          "label": "Meta Description",
          "placeholder": "A brief summary of the page"
        },
        "type": "Text"
      },
      "meta_image": {
        "config": {
          "constraint": {
            "height": 1260,
            "width": 2400
          },
          "label": "Meta Image",
          "thumbnails": []
        },
        "type": "Image"
      }
    }
  }
}
