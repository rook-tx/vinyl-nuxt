{
  "name": "vinyl-nuxt",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --host",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:watch": "node node_modules/vitest/vitest.mjs",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:import:prismic": "node prisma/import-prismic.mjs",
    "db:import:prismic:dry": "node prisma/import-prismic.mjs --dry-run",
    "db:import:prismic:strict": "node prisma/import-prismic.mjs --strict-relationships",
    "db:import:prismic:strict:dry": "node prisma/import-prismic.mjs --dry-run --strict-relationships",
    "db:studio": "prisma studio",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@nuxt/eslint": "^1.13.0",
    "@nuxt/fonts": "^0.13.0",
    "@nuxt/image": "^2.0.0",
    "@prisma/client": "^6.16.1",
    "eslint": "^9.39.2",
    "fuse.js": "^7.1.0",
    "keen-slider": "^6.8.6",
    "nuxt": "^4.3.0",
    "nuxt-lucide-icons": "^2.0.0",
    "vue": "^3.5.27",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "prisma": "^6.16.1",
    "stylus": "^0.64.0",
    "vitest": "^4.1.10"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  }
}
